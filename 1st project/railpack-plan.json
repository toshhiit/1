{
  "name": "telegram-bot",
  "build": {
    "commands": [
      "echo 'Build started...'",
      "ls -la",                      // Проверка, что файл есть
      "chmod +x start.sh"
    ]
  },
 "start": {
  "command": "gunicorn server:app --bind 0.0.0.0:$PORT --workers 4"
}
  },
  "env": [
    "BOT_TOKEN",
    "DATABASE_URL",
    "SITE_URL"
  ]
}
