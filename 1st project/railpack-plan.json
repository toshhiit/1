{
  "name": "telegram-bot",
  "build": {
    "commands": [
      "echo 'Build started...'",
      "ls -la",                      // Проверка, что файл есть
      "chmod +x start.sh"
    ]
  },
  "start": {
    "command": "./start.sh"
  },
  "env": [
    "BOT_TOKEN",
    "DATABASE_URL",
    "SITE_URL"
  ]
}
