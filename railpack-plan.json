{
  "name": "telegram-bot",
  "build": {
    "image": "python:3.11-slim",
    "commands": [
      "python -m pip install --upgrade pip",
      "python -m pip install -r requirements.txt"
    ]
  },
  "start": {
    "command": "python server.py"
  },
  "env": [
    "BOT_TOKEN",
    "DATABASE_URL",
    "SITE_URL"
  ]
}
