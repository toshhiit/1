{
  "name": "telegram-bot",
  "build": {
    "image": "python:3.11-slim",
    "commands": [
      "pip install --upgrade pip",
      "pip install -r requirements.txt"
    ]
  },
  "start": {
    "command": "sh -c \"gunicorn server:app --bind 0.0.0.0:$PORT --workers 4 & python tgbot.py\""
  },
  "env": [
    "BOT_TOKEN",
    "DATABASE_URL",
    "SITE_URL"
  ]
}
